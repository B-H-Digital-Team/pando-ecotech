---
/** Mark + wordmark ("PANDO" over "ECOTECH", as on the original logo). */
import Mark from './Mark.astro';

interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="logo" href={href} aria-label={label}>
  <Mark size={30} />
  <span class="word" aria-hidden="true">
    <span class="pando">PANDO</span>
    <span class="eco"><b>ECO</b>TECH</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text);
  }
  .logo :global(.mark) {
    transition: transform 0.6s var(--ease-spring);
  }
  .logo:hover :global(.mark) {
    transform: rotate(-8deg) scale(1.06);
  }
  .word {
    display: grid;
    line-height: 1;
  }
  .pando {
    font-size: 1.32rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--logo-blue);
  }
  .eco {
    margin-top: 0.12rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--logo-blue);
  }
  .eco b {
    font-weight: 600;
    color: var(--logo-green);
  }
</style>
