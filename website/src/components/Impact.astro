---
/** "Đóng góp của chúng ta": three photo cards on a roast panel, numbered in serif. */
import { Image } from 'astro:assets';
import Headline from './Headline.astro';
import { IMPACT } from '../data/story';
import { tx, useTranslations, type Locale } from '../i18n';
import { photo } from '../lib/photos';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="impact panel on-panel">
  <div class="container section">
    <div class="section-head">
      <p class="tag" data-reveal>{t.home.impactTag}</p>
      <Headline text={t.home.impactTitle} />
    </div>
    <ol class="cards" data-reveal-group>
      {
        IMPACT.map((item, index) => (
          <li class="card-i spot" data-tilt="4">
            <span class="photo drift">
              <Image src={photo(item.photo)} alt="" widths={[420, 700]} sizes="(min-width: 900px) 30vw, 92vw" />
            </span>
            <span class="num">0{index + 1}</span>
            <h3>{tx(locale, item.title)}</h3>
            <p>{tx(locale, item.text)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
    .cards > :nth-child(2) {
      margin-top: 3rem;
    }
  }
  .card-i {
    position: relative;
    padding: 0.7rem 0.7rem 1.8rem;
    border-radius: var(--radius-xl);
    background: var(--glass-panel);
    box-shadow: inset 0 0 0 1px var(--line-panel);
  }
  .card-i .photo {
    display: block;
    aspect-ratio: 5 / 4;
    border-radius: calc(var(--radius-xl) - 8px);
    margin-bottom: 1.2rem;
  }
  .num {
    position: absolute;
    top: 1.4rem;
    right: 1.6rem;
    z-index: 2;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 3rem;
    line-height: 1;
    color: var(--gold-light);
    text-shadow: 0 4px 20px rgb(0 0 0 / 0.5);
  }
  h3,
  p {
    padding-inline: 1rem;
  }
  h3 {
    margin-bottom: 0.5rem;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
</style>
