---
/**
 * First screen: a dim photograph of coffee-ground coasters settles into
 * focus, and over it thousands of coffee specks (particles.ts, WebGL) gather
 * into the Pando mark on the right. The headline rises word by word on the
 * left. The pointer parts the specks; scrolling blows them away. Under the
 * panel, four facts float up over its edge.
 */
import { Image } from 'astro:assets';
import Headline from './Headline.astro';
import { localePath, useTranslations, type Locale } from '../i18n';
import { photo } from '../lib/photos';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="hero" data-tone="cream">
  <div class="panel stage on-photo">
    <div class="backdrop" aria-hidden="true">
      <Image src={photo('hero-coasters')} alt="" widths={[640, 1100, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="scrim" aria-hidden="true"></div>
    <span class="bloom" aria-hidden="true"></span>
    <canvas class="specks" aria-hidden="true"></canvas>

    <div class="container content">
      <div class="copy">
        <p class="tag rise" style="--d:0.1s">{t.home.heroTag}</p>
        <Headline as="h1" text={t.home.title} animate />
        <p class="lead rise" style="--d:0.75s">{t.home.subtitle}</p>
        <div class="ctas rise" style="--d:0.9s">
          <a class="btn btn-accent" href={localePath(locale, 'products')}>{t.home.primaryCta} <span class="arrow" aria-hidden="true"></span></a>
          <a class="btn btn-glass" href={localePath(locale, 'story')}>{t.home.secondaryCta}</a>
        </div>
      </div>
      <p class="sig rise" style="--d:2.6s" aria-hidden="true"><span>60%</span> {locale === 'vi' ? 'bã cà phê' : 'coffee grounds'} · <span>0%</span> {locale === 'vi' ? 'nhựa' : 'plastic'}</p>
    </div>

    <a class="scroll-cue" href="#story" aria-label={t.home.scroll}>
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div class="container">
    <dl class="facts" data-reveal-group>
      {
        t.home.facts.map((fact) => (
          <div class="fact spot">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  import { startParticles } from '../scripts/particles';

  const canvas = document.querySelector<HTMLCanvasElement>('.hero .specks');
  if (canvas) startParticles(canvas);
</script>

<style>
  .hero {
    padding-top: var(--frame);
  }
  .stage {
    min-height: min(calc(100svh - var(--header-h) - 2 * var(--frame)), 1000px);
    display: grid;
    align-items: end;
    color: var(--on-photo);
    background: var(--ink-black);
  }
  .backdrop {
    position: absolute;
    inset: -10% 0 0;
    z-index: -2;
  }
  .backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    opacity: 0.55;
    animation: settle 2.6s var(--ease-out) var(--intro, 0s) both;
  }
  @keyframes settle {
    from {
      transform: scale(1.16);
      filter: blur(8px) brightness(0.6);
    }
  }
  @supports (animation-timeline: scroll()) {
    .backdrop {
      animation: sink linear both;
      animation-timeline: scroll(root);
      animation-range: 0 100vh;
    }
    @keyframes sink {
      to {
        transform: translateY(14%) scale(1.06);
      }
    }
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(30% 48% at 74% 48%, var(--scrim-strong), transparent 80%),
      linear-gradient(to top, var(--scrim-strong) 0%, var(--scrim) 45%, var(--scrim-soft) 80%),
      linear-gradient(to right, var(--scrim-strong), transparent 70%);
  }
  .bloom {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(30% 40% at 74% 46%, var(--gold-haze), transparent 70%),
      radial-gradient(22% 26% at 92% 80%, var(--leaf-glow), transparent 70%);
    animation: breathe 7s ease-in-out infinite;
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
  .specks {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-top: clamp(14rem, 34vh, 20rem);
    padding-bottom: clamp(7rem, 12vw, 9.5rem);
  }
  @media (min-width: 1040px) {
    .content {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      padding-top: clamp(6rem, 14vh, 10rem);
    }
  }
  .copy :global(h1) {
    max-width: 14ch;
    font-size: clamp(2.6rem, 5.4vw, 5.6rem);
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 40px var(--scrim);
  }
  .copy .lead {
    color: var(--on-photo-muted);
    max-width: 36rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  /* A whispered caption under the mark. */
  .sig {
    display: none;
    margin: 0;
    justify-self: center;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--on-photo-faint);
  }
  .sig span {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--gold-light);
  }
  @media (min-width: 1040px) {
    .sig {
      display: block;
    }
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(5.5rem, 8vw, 7rem);
    z-index: 2;
    display: none;
    width: 28px;
    height: 46px;
    margin-left: -14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--line-photo);
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 4px;
    background: var(--on-photo);
    animation: cue 1.8s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @media (min-width: 1040px) and (min-height: 760px) {
    .scroll-cue {
      display: block;
    }
  }

  .facts {
    position: relative;
    z-index: 2;
    margin: calc(-1 * clamp(4.5rem, 7vw, 5.5rem)) 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.6rem, 1.4vw, 1rem);
  }
  @media (min-width: 900px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: clamp(1.1rem, 2.4vw, 1.75rem);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-float);
    overflow: hidden;
  }
  .fact dd {
    margin: 0;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .fact:first-child dd {
    color: var(--gold);
  }
  .fact:nth-child(3) dd {
    color: var(--accent);
  }
  .fact dt {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.4;
    max-width: 16rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .backdrop img {
      animation: none;
    }
    .backdrop,
    .bloom,
    .scroll-cue span {
      animation: none !important;
    }
  }
</style>
