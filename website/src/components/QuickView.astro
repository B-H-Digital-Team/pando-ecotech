---
/**
 * Quick view: a dialog filled by quickview.ts from the catalogue below when a
 * product card's eye button is pressed. Products sold on the order form list
 * their variants with "Add to order" (cart.ts); the others offer Zalo.
 */
import { getImage } from 'astro:assets';
import { CATEGORIES, MATERIALS, PRODUCTS } from '../data/products';
import { SHOP } from '../data/shop';
import { COMPANY } from '../data/site';
import { localePath, money, tx, useTranslations, type Locale } from '../i18n';
import { photo } from '../lib/photos';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const data = await Promise.all(
  PRODUCTS.map(async (product) => ({
    slug: product.slug,
    name: tx(locale, product.name),
    tagline: tx(locale, product.tagline),
    intro: tx(locale, product.intro),
    category: tx(locale, CATEGORIES.find((c) => c.key === product.category)!.name),
    materials: product.materials.map((key) => ({ key, name: tx(locale, MATERIALS.find((m) => m.key === key)!.name) })),
    size: product.size ?? '',
    url: localePath(locale, `san-pham/${product.slug}`),
    images: await Promise.all(
      [product.cover, ...product.gallery.filter((g) => g !== product.cover)].slice(0, 4).map(async (name) => (await getImage({ src: photo(name), width: 900, format: 'webp' })).src),
    ),
    variants: SHOP.filter((item) => product.shop?.includes(item.id)).map((item) => ({ id: item.id, name: tx(locale, item.name), price: money(locale, item.price) })),
  })),
);
const labels = {
  add: t.common.addToOrder,
  added: t.common.added,
  ask: t.common.askPrice,
  details: t.common.details,
  size: t.products.size,
  choose: t.common.chooseVariant,
  zalo: COMPANY.zalo,
};
---

<dialog class="qv-dialog" aria-labelledby="qv-name" data-lenis-prevent>
  <div class="qv-card">
    <button class="qv-close" type="button" data-qv-close aria-label={t.common.close}>×</button>
    <div class="qv-media">
      <img class="qv-main" src="data:," alt="" />
      <div class="qv-thumbs"></div>
    </div>
    <div class="qv-info">
      <p class="qv-cat"></p>
      <h2 id="qv-name"></h2>
      <p class="qv-tagline"></p>
      <p class="qv-mats"></p>
      <p class="qv-intro"></p>
      <div class="qv-buy"></div>
      <a class="link qv-more" href="#">{t.common.details} →</a>
    </div>
  </div>
  <script type="application/json" id="qv-data" set:html={JSON.stringify({ products: data, labels })} />
</dialog>

<script>
  import '../scripts/quickview';
</script>

<style>
  .qv-dialog {
    width: min(1040px, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-float);
    overflow: auto;
    overscroll-behavior: contain;
    /* Long content still scrolls on small screens, without a bar breaking the rounded card. */
    scrollbar-width: none;
  }
  .qv-dialog::-webkit-scrollbar,
  .qv-info::-webkit-scrollbar {
    display: none;
  }
  .qv-dialog[open] {
    animation: qv-in 0.26s var(--ease-out);
  }
  .qv-dialog::backdrop {
    background: rgb(15 10 6 / 0.6);
    backdrop-filter: blur(8px);
    animation: fade-in 0.26s var(--ease-out);
  }
  @keyframes qv-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
  }
  .qv-card {
    position: relative;
    display: grid;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(0.8rem, 2vw, 1.2rem);
  }
  /*
   * Large screens: the card is as tall as its text (never taller than the
   * screen) and the photo stretches to match, so the dialog itself never
   * scrolls. Only text taller than the screen scrolls, inside its column.
   */
  @media (min-width: 820px) {
    .qv-dialog {
      overflow: hidden;
    }
    .qv-dialog .qv-card {
      grid-template-columns: 1.05fr 1fr;
      grid-template-rows: minmax(0, 1fr);
      max-height: calc(100dvh - 2rem);
    }
    .qv-dialog .qv-media {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 0.5rem;
      min-height: 0;
    }
    .qv-dialog .qv-main {
      height: 100%;
      min-height: 22rem;
      aspect-ratio: auto;
    }
    .qv-dialog .qv-thumbs {
      grid-template-columns: repeat(4, minmax(0, 84px));
      margin-top: 0;
    }
    .qv-dialog .qv-info {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
  }
  .qv-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--glass);
    color: var(--text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease-out;
  }
  .qv-close:hover {
    transform: rotate(90deg);
  }
  .qv-main {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius-xl) - 8px);
    background: var(--surface-2);
    transition: opacity 0.2s ease;
  }
  .qv-main:global(.is-swapping) {
    opacity: 0.3;
  }
  .qv-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .qv-thumbs :global(button) {
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 1;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .qv-thumbs :global(button[aria-pressed='true']),
  .qv-thumbs :global(button:hover) {
    opacity: 1;
  }
  .qv-thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .qv-info {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(0.4rem, 2vw, 1.4rem) clamp(0.4rem, 2vw, 1.2rem) 1rem 0;
  }
  .qv-cat {
    margin: 0;
    font-size: 0.85rem;
    color: var(--gold);
    font-weight: 600;
  }
  .qv-info h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
  }
  .qv-tagline {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--accent);
  }
  .qv-mats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .qv-mats :global(span) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .qv-intro {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
  .qv-buy {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .qv-buy :global(.variant) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .qv-buy :global(.variant b) {
    display: block;
    color: var(--gold);
  }
  .qv-buy :global(.variant small) {
    font-size: 0.9rem;
  }
  .qv-more {
    justify-self: start;
    margin-top: 0.6rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .qv-dialog[open],
    .qv-dialog::backdrop {
      animation: none;
    }
  }
</style>
