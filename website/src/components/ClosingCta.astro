---
/** The closing invitation at the end of every page: a photo panel with three ways to reach Pando. */
import { Image } from 'astro:assets';
import Headline from './Headline.astro';
import Grounds from './Grounds.astro';
import { localePath, useTranslations, type Locale } from '../i18n';
import { COMPANY } from '../data/site';
import { photo } from '../lib/photos';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="closing panel on-photo grow-in" aria-labelledby="closing-title">
  <div class="bg drift" aria-hidden="true">
    <Image src={photo('drinks-garden-2')} alt="" widths={[640, 1100, 1600]} sizes="100vw" />
  </div>
  <div class="scrim" aria-hidden="true"></div>
  <Grounds count={16} />
  <div class="container inner">
    <Headline id="closing-title" text={t.home.closingTitle} />
    <p class="lead" data-reveal>{t.home.closingText}</p>
    <div class="ctas" data-reveal>
      <a class="btn btn-light" href={localePath(locale, 'order')}>{t.common.orderNow} <span class="arrow" aria-hidden="true"></span></a>
      <a class="btn btn-glass" href={COMPANY.zalo} rel="noopener" target="_blank">{t.common.chatZalo}</a>
      <a class="btn btn-glass" href={COMPANY.phoneHref}>{COMPANY.phone}</a>
    </div>
  </div>
</section>

<style>
  .closing {
    margin-top: var(--section);
    min-height: min(80vh, 760px);
    display: grid;
    align-items: center;
    color: var(--on-photo);
    background: var(--ink-black);
    text-align: center;
  }
  /* Taller than the panel so the drifting photo always covers it. */
  .bg {
    position: absolute;
    inset: -12% 0;
    z-index: -2;
    overflow: hidden;
  }
  .bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 60% at 50% 50%, var(--scrim), var(--scrim-strong)),
      linear-gradient(0deg, var(--scrim-strong), transparent 50%);
  }
  .inner {
    position: relative;
    display: grid;
    justify-items: center;
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  .inner :global(h2) {
    max-width: 15ch;
    margin-bottom: 1.5rem;
  }
  .lead {
    color: var(--on-photo-muted);
    margin-inline: auto;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
