---
/**
 * The full Pando logo in its own colours (blue mark and PANDO, green ECO,
 * blue TECH), stacked or in a row, for the loading screens. Not a link.
 */
import { MARK_PATHS } from '../lib/mark';

interface Props {
  layout?: 'stack' | 'row';
  size?: number;
  class?: string;
}
const { layout = 'stack', size = 56, class: className } = Astro.props;
---

<span class:list={['lockup', layout, className]} style={`--s:${size}px`} aria-label="Pando Ecotech" role="img">
  <svg viewBox="-6 -6 206 262" aria-hidden="true">
    {MARK_PATHS.map((d) => <path d={d} />)}
  </svg>
  <span class="word" aria-hidden="true">
    <span class="pando">PANDO</span>
    <span class="eco"><b>ECO</b>TECH</span>
  </span>
</span>

<style>
  .lockup {
    --blue: #2a5ea8;
    --green: #7cb342;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--s) * 0.22);
    line-height: 1;
  }
  .stack {
    flex-direction: column;
  }
  svg {
    width: var(--s);
    height: calc(var(--s) * 1.27);
    fill: var(--blue);
  }
  .word {
    display: grid;
    justify-items: center;
  }
  .row .word {
    justify-items: start;
  }
  .pando {
    font-size: calc(var(--s) * 0.56);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--blue);
  }
  .eco {
    margin-top: calc(var(--s) * 0.05);
    font-size: calc(var(--s) * 0.24);
    font-weight: 600;
    letter-spacing: 0.34em;
    color: var(--blue);
    padding-left: 0.34em;
  }
  .eco b {
    font-weight: 600;
    color: var(--green);
  }
</style>
