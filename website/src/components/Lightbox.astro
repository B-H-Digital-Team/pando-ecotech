---
/** The shared photo viewer for every [data-lightbox] gallery (motion.ts). */
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<dialog class="lightbox" aria-label={t.common.zoom} data-lenis-prevent>
  <figure>
    <img src="data:," alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="lb-btn close" type="button" data-close aria-label={t.common.close}>×</button>
  <button class="lb-btn prev" type="button" data-prev aria-label={t.common.prev}>‹</button>
  <button class="lb-btn next" type="button" data-next aria-label={t.common.next}>›</button>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--on-night);
  }
  .lightbox::backdrop {
    background: rgb(10 7 5 / 0.88);
    backdrop-filter: blur(10px);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade-in 0.3s ease;
  }
  figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    padding: 4rem 1rem 2rem;
  }
  img {
    max-width: min(92vw, 1400px);
    max-height: 78dvh;
    width: auto;
    border-radius: var(--radius);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.4s ease,
      transform 0.6s var(--ease-out);
  }
  img:global(.is-in) {
    opacity: 1;
    transform: none;
  }
  figcaption {
    color: var(--on-night-muted);
    font-size: 0.95rem;
    text-align: center;
  }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: var(--glass-night);
    color: var(--on-night);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--line-night);
    transition:
      background-color 0.2s ease,
      transform 0.35s var(--ease-spring);
  }
  .lb-btn:hover {
    background: var(--gold);
    color: var(--gold-ink);
    transform: scale(1.08);
  }
  .close {
    top: 1rem;
    right: 1rem;
  }
  .prev,
  .next {
    top: 50%;
    margin-top: -26px;
  }
  .prev {
    left: 1rem;
  }
  .next {
    right: 1rem;
  }
</style>
