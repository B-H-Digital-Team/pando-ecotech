---
/** A news story: photo (shared view-transition name with the article cover), kind, place, title. */
import { Image } from 'astro:assets';
import type { Article } from '../data/news';
import { localePath, tx, type Locale } from '../i18n';
import { photo } from '../lib/photos';

interface Props {
  article: Article;
  locale: Locale;
  large?: boolean;
}
const { article, locale, large = false } = Astro.props;
---

<a class:list={['news-card', 'spot', { large }]} href={localePath(locale, `tin-tuc/${article.slug}`)} data-vt>
  <span class="photo">
    <Image
      src={photo(article.cover)}
      alt=""
      widths={[420, 720, 1100]}
      sizes={large ? '(min-width: 900px) 60vw, 92vw' : '(min-width: 900px) 30vw, 92vw'}
      style={`view-transition-name: news-${article.slug}`}
    />
  </span>
  <span class="meta"><b>{tx(locale, article.kind)}</b> · {tx(locale, article.place)}</span>
  <span class="title">{tx(locale, article.title)}</span>
  <span class="excerpt">{tx(locale, article.excerpt)}</span>
</a>

<style>
  .news-card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    height: 100%;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .photo {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    margin-bottom: 0.5rem;
  }
  .large .photo {
    aspect-ratio: 16 / 10;
  }
  .photo img {
    transition: transform 1.1s var(--ease-out);
  }
  .news-card:hover .photo img {
    transform: scale(1.06);
  }
  .meta {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .meta b {
    font-weight: 600;
    color: var(--gold);
  }
  .title {
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.02em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }
  .large .title {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }
  .news-card:hover .title {
    background-size: 100% 1px;
  }
  .excerpt {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
