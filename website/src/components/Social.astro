---
/** Round links to Facebook, TikTok, Zalo and email. */
import { COMPANY } from '../data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const LINKS = [
  {
    href: COMPANY.facebook,
    label: 'Facebook',
    path: 'M14 8.5V6.6c0-.8.2-1.3 1.4-1.3H17V2.2C16.7 2.1 15.7 2 14.6 2 12.2 2 10.6 3.4 10.6 6.1v2.4H8v3.4h2.6V22H14V11.9h2.7l.4-3.4Z',
  },
  {
    href: COMPANY.tiktok,
    label: 'TikTok',
    path: 'M16.6 2h-3.3v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .8.1V9.2a6.3 6.3 0 1 0 5.4 6.2V8.7A7.7 7.7 0 0 0 21 10.2V6.9a4.4 4.4 0 0 1-4.4-4.4Z',
  },
  {
    href: COMPANY.zalo,
    label: 'Zalo',
    path: 'M12 3C6.5 3 2 6.8 2 11.4c0 2.6 1.4 4.9 3.7 6.4L5 21l3.6-1.9c1.1.3 2.2.5 3.4.5 5.5 0 10-3.8 10-8.3S17.5 3 12 3ZM9 8.6h6v1.3l-3.9 3.9H15v1.3H9v-1.3l3.9-3.9H9Z',
  },
  {
    href: `mailto:${COMPANY.email}`,
    label: 'Email',
    path: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.6L4.4 7.2v.1L12 12.8l7.6-5.5v-.1L12 12.6Z',
  },
];
---

<ul class:list={['social', className]}>
  {
    LINKS.map((link) => (
      <li>
        <a href={link.href} rel="noopener" target={link.href.startsWith('mailto') ? undefined : '_blank'} aria-label={link.label} title={link.label}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d={link.path} fill="currentColor" fill-rule="evenodd" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }
  a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--text);
    background: var(--hover);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      transform 0.45s var(--ease-spring),
      background-color 0.25s ease,
      color 0.25s ease;
  }
  a:hover {
    transform: translateY(-3px) rotate(-6deg);
    background: var(--gold);
    color: var(--gold-ink);
  }
</style>
