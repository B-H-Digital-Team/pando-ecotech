---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Headline from '../../components/Headline.astro';
import { SHOP, type ShopItem } from '../../data/shop';
import { COMPANY, PAYMENT, SHIPPING } from '../../data/site';
import { format, localePath, localeStaticPaths, money, tx, useTranslations, type Locale } from '../../i18n';
import { photo } from '../../lib/photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const groups = (['candle', 'coaster', 'keychain'] as const).map((key) => ({
  key,
  name: t.order.groups[key],
  items: SHOP.filter((item) => item.group === key),
}));
const config = {
  locale,
  items: SHOP.map((item: ShopItem) => ({ id: item.id, name: tx(locale, item.name), price: item.price, unit: tx(locale, item.unit) })),
  shipping: SHIPPING,
  zalo: COMPANY.zalo,
  text: {
    intro: t.order.orderText,
    total: t.order.orderTotal,
    empty: t.order.empty,
    copied: t.common.copied,
    copy: t.order.copyOrder,
    count: t.order.itemCount,
    remove: t.order.removeItem,
    cleared: t.order.cleared,
    undo: t.order.undo,
  },
};
// Read the account the way it is printed on bank slips: 0935 832 459.
const accountGroups = PAYMENT.account.replace(/^(\d{4})(\d{3})(\d+)$/, '$1 $2 $3');
const ICONS: Record<ShopItem['group'], string> = {
  candle: 'M12 3c1.6 1.8 2.2 3.1 1.6 4.3-.4.9-1.2 1.3-1.6 1.3s-1.2-.4-1.6-1.3C9.8 6.1 10.4 4.8 12 3ZM12 10v2M6 13h12l-1.2 7.2a1 1 0 0 1-1 .8H8.2a1 1 0 0 1-1-.8L6 13Z',
  coaster: 'M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18Zm0 3a6 6 0 1 0 0 12 6 6 0 0 0 0-12Z',
  keychain: 'M8 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm2.8 6.8 5.4 5.4M14 13l2-2M16.5 15.5l2-2M15.5 21c-2-1-3-3-3-5 2 0 4 1 5 3',
};
---

<Base
  locale={locale}
  page="order"
  title={t.meta.order.title}
  description={t.meta.order.description}
  image="coaster-coffee-tray"
  breadcrumbs={[{ name: t.nav.order, path: localePath(locale, 'order') }]}
  showClosing={false}
>
  <PageHeader locale={locale} tag={t.order.tag} title={t.order.title} lead={t.order.lead} crumbs={[{ name: t.nav.order, path: '' }]}>
    <ol class="steps rise" style="--d:0.7s">
      {
        t.order.steps.map((step, index) => (
          <li>
            <span class="sn">{index + 1}</span>
            <b>{step.title}</b>
            <span>{step.text}</span>
          </li>
        ))
      }
    </ol>
  </PageHeader>

  <section class="container builder" data-order={JSON.stringify(config)}>
    <div class="list">
      <h2 class="visually-hidden">{t.order.pick}</h2>
      {
        groups.map((group) => (
          <fieldset class="group" data-reveal>
            <legend>{group.name}</legend>
            <ul>
              {group.items.map((item) => (
                <li class="item spot" data-item={item.id}>
                  <span class:list={['thumb', `finish-${item.finish}`]}>
                    {item.photo ? (
                      <Image src={photo(item.photo)} alt="" widths={[120, 200]} sizes="88px" />
                    ) : (
                      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
                        <path d={ICONS[item.group]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <span class="meta">
                    <span class="name">
                      {item.product ? <a href={localePath(locale, `san-pham/${item.product}`)}>{tx(locale, item.name)}</a> : tx(locale, item.name)}
                    </span>
                    <span class="price">
                      {money(locale, item.price)}
                      <small>{format(t.order.each, { unit: tx(locale, item.unit) })}</small>
                    </span>
                  </span>
                  <span class="stepper">
                    <button type="button" data-step="-1" aria-label={`${t.order.decrease}: ${tx(locale, item.name)}`}>
                      −
                    </button>
                    <input type="number" min="0" max="999" value="0" inputmode="numeric" aria-label={`${t.order.qty}: ${tx(locale, item.name)}`} />
                    <button type="button" data-step="1" aria-label={`${t.order.increase}: ${tx(locale, item.name)}`}>
                      +
                    </button>
                  </span>
                </li>
              ))}
            </ul>
          </fieldset>
        ))
      }
    </div>

    <aside class="summary panel on-panel" aria-labelledby="summary-title">
      <div class="summary-head">
        <h2 id="summary-title">{t.order.summary}</h2>
        <span class="count" data-count hidden></span>
        <button type="button" class="clear" data-clear hidden>{t.order.clearAll}</button>
      </div>
      <div class="lines-box">
        <ul class="lines" data-lines aria-live="polite">
          <li class="empty">{t.order.empty}</li>
        </ul>
      </div>
      <fieldset class="area">
        <legend>{t.order.area}</legend>
        <label>
          <input type="radio" name="area" value="inner" checked />
          <span>
            <b>{t.order.inner}</b>
            <small>{money(locale, SHIPPING.inner.min)} - {money(locale, SHIPPING.inner.max)}</small>
            <small>{format(t.order.eta, { days: SHIPPING.innerDays })}</small>
          </span>
        </label>
        <label>
          <input type="radio" name="area" value="outer" />
          <span>
            <b>{t.order.outer}</b>
            <small>{money(locale, SHIPPING.outer.min)} - {money(locale, SHIPPING.outer.max)}</small>
            <small>{format(t.order.eta, { days: SHIPPING.outerDays })}</small>
          </span>
        </label>
        <p class="ship-note">{t.order.shippingNote}</p>
      </fieldset>
      <p class="grand">
        <span>{t.order.total}</span>
        <b data-total>{money(locale, 0)}</b>
      </p>
      <div class="actions">
        <a class="btn btn-accent" href={COMPANY.zalo} rel="noopener" target="_blank" data-send-zalo>{t.order.sendZalo}</a>
        <button type="button" class="btn btn-ghost" data-copy-order>{t.order.copyOrder}</button>
        <a class="form-link" href={COMPANY.orderForm} rel="noopener" target="_blank">{t.order.openForm}</a>
      </div>
    </aside>
  </section>

  <section class="section container pay">
    <div>
      <p class="tag" data-reveal>{t.order.payTag}</p>
      <Headline text={t.order.payTitle} />
      <p class="muted" data-reveal>{t.order.payNote}</p>
    </div>
    <div class="slip-wrap" data-reveal="scale">
      <div class="slip">
        <div class="slip-top">
          <span class="bank-mark" aria-hidden="true">MB</span>
          <p class="bank-name">
            <small>{t.order.bank}</small>
            {PAYMENT.bank}
          </p>
        </div>
        <dl class="slip-body">
          <div>
            <dt>{t.order.account}</dt>
            <dd class="acc">
              <span class="acc-num" aria-label={PAYMENT.account}>{accountGroups}</span>
              <button type="button" class="copy" data-copy={PAYMENT.account}>
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                  <rect x="7" y="7" width="10" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
                  <path d="M13 4.5A1.5 1.5 0 0 0 11.5 3h-6A2.5 2.5 0 0 0 3 5.5v6A1.5 1.5 0 0 0 4.5 13" fill="none" stroke="currentColor" stroke-width="1.6"></path>
                </svg>
                <span class="c1">{t.common.copy}</span><span class="c2">{t.common.copied}</span>
              </button>
            </dd>
          </div>
          <div>
            <dt>{t.order.holder}</dt>
            <dd class="holder">{PAYMENT.holder}</dd>
          </div>
        </dl>
        <div class="slip-strip" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/order';
</script>

<style>
  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .steps b {
    color: var(--text);
    font-weight: 500;
    font-size: 1rem;
  }
  .sn {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .builder {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .builder {
      grid-template-columns: 1.4fr 1fr;
    }
    /* Pinned beside the list and never taller than the screen: the lines give up their height first. */
    .summary {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
      display: flex;
      flex-direction: column;
      max-height: calc(100dvh - var(--header-h) - 2rem);
      overflow-y: auto;
      scrollbar-width: none;
    }
    .summary::-webkit-scrollbar {
      display: none;
    }
    .summary > * {
      flex: none;
    }
    .summary > .lines-box {
      flex: 0 1 auto;
      min-height: 7.5rem;
    }
    .summary .lines {
      max-height: none;
    }
  }
  .group {
    margin: 0 0 2rem;
    padding: 0;
    border: 0;
  }
  .group legend {
    margin-bottom: 0.9rem;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.8rem 0.6rem 0.6rem;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      box-shadow 0.3s ease,
      transform 0.4s var(--ease-out);
  }
  .item:global(.has-qty) {
    box-shadow:
      inset 0 0 0 2px var(--accent),
      var(--shadow);
  }
  .thumb {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface-2);
    color: var(--mat-coffee-2);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .finish-titan {
    background: color-mix(in srgb, var(--titan) 22%, var(--surface-2));
    color: var(--titan);
  }
  .finish-warm {
    background: var(--gold-soft);
    color: var(--gold);
  }
  .finish-titan img {
    filter: grayscale(0.85) contrast(1.05);
  }
  .meta {
    display: grid;
    gap: 0.2rem;
  }
  .name {
    font-weight: 500;
    line-height: 1.35;
  }
  .name a {
    text-decoration: none;
  }
  .name a:hover {
    color: var(--accent);
  }
  .price {
    color: var(--gold);
    font-weight: 600;
  }
  .price small {
    color: var(--muted);
    font-weight: 400;
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--hover);
  }
  .stepper button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.2rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.3s var(--ease-spring);
  }
  .stepper button:hover {
    background: var(--surface);
  }
  .stepper button:active {
    transform: scale(0.88);
  }
  .stepper input {
    width: 2.6rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .stepper input::-webkit-inner-spin-button,
  .stepper input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }
  @media (max-width: 520px) {
    .item {
      grid-template-columns: auto 1fr;
    }
    .stepper {
      grid-column: 1 / -1;
      justify-self: end;
    }
  }

  .summary {
    margin: 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .summary-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }
  .summary h2 {
    margin: 0;
    font-size: clamp(1.25rem, 4.6vw, 1.5rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .count,
  .clear {
    white-space: nowrap;
  }
  .count {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--gold-soft);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .clear {
    margin-inline-start: auto;
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .clear:hover {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 8%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--danger) 35%, transparent);
  }
  .count[hidden],
  .clear[hidden] {
    display: none;
  }
  /* The chosen lines scroll inside their box, without a bar; a fade says more lines wait below (order.ts). */
  .lines-box {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .lines-box::after {
    content: '';
    position: absolute;
    inset: auto 1px 1px;
    height: 2.6rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: linear-gradient(transparent, var(--surface));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .lines-box:global(.has-more)::after {
    opacity: 1;
  }
  .lines {
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-height: 0;
    max-height: 19rem;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .lines::-webkit-scrollbar {
    display: none;
  }
  .lines :global(.line) {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.4rem 0.55rem 0.75rem;
    border-radius: calc(var(--radius-sm) - 4px);
    font-size: 0.93rem;
    animation: rise 0.45s var(--ease-out) both;
    transition: background-color 0.2s ease;
  }
  .lines :global(.line:hover) {
    background: var(--hover);
  }
  .lines :global(.line-name) {
    display: grid;
    gap: 0.1rem;
    line-height: 1.35;
  }
  .lines :global(.line-name small) {
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .lines :global(.line b) {
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .lines :global(.line-remove) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .lines :global(.line-remove:hover),
  .lines :global(.line-remove:focus-visible) {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 10%, transparent);
  }
  .lines :global(.empty) {
    padding: 1.1rem 0.8rem;
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
  }
  .lines :global(.undo) {
    margin-inline-start: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  /* Two delivery areas side by side; the legend floats so it sits inside the grid. */
  .area {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }
  @media (max-width: 480px) {
    .area {
      grid-template-columns: 1fr;
    }
  }
  .area legend {
    float: left;
    grid-column: 1 / -1;
    margin-bottom: 0.1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .area label {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    padding: 0.65rem 0.7rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.93rem;
    line-height: 1.35;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .area label:hover {
    background: var(--hover);
  }
  .area label:has(input:checked) {
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }
  .area input {
    flex: none;
    accent-color: var(--accent);
    margin: 0.2rem 0 0;
  }
  .area span {
    display: grid;
    gap: 0.1rem;
  }
  .area b {
    font-weight: 600;
  }
  .area small {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .ship-note {
    grid-column: 1 / -1;
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .grand {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 0 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .grand b {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .grand b:global(.bump) {
    animation: bump 0.45s var(--ease-spring);
  }
  @keyframes bump {
    40% {
      transform: scale(1.08);
    }
  }
  .actions {
    display: grid;
    gap: 0.6rem;
  }
  .form-link {
    justify-self: center;
    padding: 0.5rem;
    color: var(--muted);
    font-size: 0.92rem;
    text-underline-offset: 4px;
  }
  .form-link:hover {
    color: var(--text);
  }
  .actions :global(.is-done) {
    --btn-bg: var(--accent-soft);
    --btn-fg: var(--accent-strong);
  }

  .pay {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .pay {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* The transfer slip: a coloured stub, a torn perforation, the details on paper, a strip of the materials' colours. */
  .slip-wrap {
    width: 100%;
    max-width: 30rem;
    filter: drop-shadow(0 22px 34px var(--shadow-ink)) drop-shadow(0 2px 3px var(--shadow-ink));
  }
  .slip {
    --cut: 6.6rem;
    --notch: 13px;
    position: relative;
    display: grid;
    border-radius: 22px;
    overflow: hidden;
    background: var(--surface);
    mask:
      radial-gradient(circle var(--notch) at 0 var(--cut), #0000 96%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--notch) at 100% var(--cut), #0000 96%, #000) right / 51% 100% no-repeat;
  }
  .slip-top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: var(--cut);
    padding-inline: clamp(1.3rem, 3vw, 1.8rem);
    color: var(--white);
    background:
      radial-gradient(60% 120% at 100% 0%, color-mix(in srgb, var(--mat-beet) 75%, transparent), transparent 70%),
      radial-gradient(55% 140% at 78% 120%, color-mix(in srgb, var(--caramel-1) 70%, transparent), transparent 70%),
      radial-gradient(50% 120% at 42% 130%, color-mix(in srgb, var(--slip-lime) 45%, transparent), transparent 70%),
      linear-gradient(120deg, var(--slip-ink) 10%, var(--slip-blue) 55%);
  }
  .bank-mark {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--white);
    color: var(--slip-blue);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }
  .bank-name {
    display: grid;
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
