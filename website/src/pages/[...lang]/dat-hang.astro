---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Headline from '../../components/Headline.astro';
import { SHOP, type ShopItem } from '../../data/shop';
import { COMPANY, PAYMENT, SHIPPING } from '../../data/site';
import { format, localePath, localeStaticPaths, money, tx, useTranslations, type Locale } from '../../i18n';
import { photo } from '../../lib/photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const groups = (['candle', 'coaster', 'keychain'] as const).map((key) => ({
  key,
  name: t.order.groups[key],
  items: SHOP.filter((item) => item.group === key),
}));
const config = {
  locale,
  items: SHOP.map((item: ShopItem) => ({ id: item.id, name: tx(locale, item.name), price: item.price, unit: tx(locale, item.unit) })),
  shipping: SHIPPING,
  zalo: COMPANY.zalo,
  text: { intro: t.order.orderText, total: t.order.orderTotal, empty: t.order.empty, copied: t.common.copied, copy: t.order.copyOrder },
};
const ICONS: Record<ShopItem['group'], string> = {
  candle: 'M12 3c1.6 1.8 2.2 3.1 1.6 4.3-.4.9-1.2 1.3-1.6 1.3s-1.2-.4-1.6-1.3C9.8 6.1 10.4 4.8 12 3ZM12 10v2M6 13h12l-1.2 7.2a1 1 0 0 1-1 .8H8.2a1 1 0 0 1-1-.8L6 13Z',
  coaster: 'M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18Zm0 3a6 6 0 1 0 0 12 6 6 0 0 0 0-12Z',
  keychain: 'M8 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm2.8 6.8 5.4 5.4M14 13l2-2M16.5 15.5l2-2M15.5 21c-2-1-3-3-3-5 2 0 4 1 5 3',
};
---

<Base
  locale={locale}
  page="order"
  title={t.meta.order.title}
  description={t.meta.order.description}
  image="coaster-coffee-tray"
  breadcrumbs={[{ name: t.nav.order, path: localePath(locale, 'order') }]}
  showClosing={false}
>
  <PageHeader locale={locale} tag={t.order.tag} title={t.order.title} lead={t.order.lead} crumbs={[{ name: t.nav.order, path: '' }]}>
    <ol class="steps rise" style="--d:0.7s">
      {
        t.order.steps.map((step, index) => (
          <li>
            <span class="sn">{index + 1}</span>
            <b>{step.title}</b>
            <span>{step.text}</span>
          </li>
        ))
      }
    </ol>
  </PageHeader>

  <section class="container builder" data-order={JSON.stringify(config)}>
    <div class="list">
      <h2 class="visually-hidden">{t.order.pick}</h2>
      {
        groups.map((group) => (
          <fieldset class="group" data-reveal>
            <legend>{group.name}</legend>
            <ul>
              {group.items.map((item) => (
                <li class="item spot" data-item={item.id}>
                  <span class:list={['thumb', `finish-${item.finish}`]}>
                    {item.photo ? (
                      <Image src={photo(item.photo)} alt="" widths={[120, 200]} sizes="88px" />
                    ) : (
                      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
                        <path d={ICONS[item.group]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <span class="meta">
                    <span class="name">
                      {item.product ? <a href={localePath(locale, `san-pham/${item.product}`)}>{tx(locale, item.name)}</a> : tx(locale, item.name)}
                    </span>
                    <span class="price">
                      {money(locale, item.price)}
                      <small>{format(t.order.each, { unit: tx(locale, item.unit) })}</small>
                    </span>
                  </span>
                  <span class="stepper">
                    <button type="button" data-step="-1" aria-label={`${t.order.decrease}: ${tx(locale, item.name)}`}>
                      −
                    </button>
                    <input type="number" min="0" max="999" value="0" inputmode="numeric" aria-label={`${t.order.qty}: ${tx(locale, item.name)}`} />
                    <button type="button" data-step="1" aria-label={`${t.order.increase}: ${tx(locale, item.name)}`}>
                      +
                    </button>
                  </span>
                </li>
              ))}
            </ul>
          </fieldset>
        ))
      }
    </div>

    <aside class="summary panel on-night" aria-labelledby="summary-title">
      <h2 id="summary-title">{t.order.summary}</h2>
      <ul class="lines" data-lines aria-live="polite">
        <li class="empty">{t.order.empty}</li>
      </ul>
      <dl class="totals">
        <div>
          <dt>{t.order.subtotal}</dt>
          <dd data-subtotal>{money(locale, 0)}</dd>
        </div>
      </dl>
      <fieldset class="area">
        <legend>{t.order.area}</legend>
        <label>
          <input type="radio" name="area" value="inner" checked />
          <span>
            <b>{t.order.inner}</b>
            <small>
              {money(locale, SHIPPING.inner.min)} - {money(locale, SHIPPING.inner.max)} · {format(t.order.eta, { days: SHIPPING.innerDays })}
            </small>
          </span>
        </label>
        <label>
          <input type="radio" name="area" value="outer" />
          <span>
            <b>{t.order.outer}</b>
            <small>
              {money(locale, SHIPPING.outer.min)} - {money(locale, SHIPPING.outer.max)} · {format(t.order.eta, { days: SHIPPING.outerDays })}
            </small>
          </span>
        </label>
        <p class="ship-note">{t.order.shippingNote}</p>
      </fieldset>
      <p class="grand">
        <span>{t.order.total}</span>
        <b data-total>{money(locale, 0)}</b>
      </p>
      <div class="actions">
        <button type="button" class="btn btn-gold" data-copy-order>{t.order.copyOrder}</button>
        <a class="btn btn-light" href={COMPANY.zalo} rel="noopener" target="_blank" data-send-zalo>{t.order.sendZalo}</a>
        <a class="btn btn-glass" href={COMPANY.orderForm} rel="noopener" target="_blank">{t.order.openForm}</a>
      </div>
    </aside>
  </section>

  <section class="section container pay">
    <div>
      <p class="tag" data-reveal>{t.order.payTag}</p>
      <Headline text={t.order.payTitle} />
      <p class="muted" data-reveal>{t.order.payNote}</p>
    </div>
    <div class="bank-card" data-reveal="scale" data-tilt="6">
      <div class="chip-row">
        <span class="chip-gold" aria-hidden="true"></span>
        <span class="bank">{PAYMENT.bank}</span>
      </div>
      <dl>
        <div>
          <dt>{t.order.account}</dt>
          <dd class="acc">
            <span>{PAYMENT.account}</span>
            <button type="button" class="copy" data-copy={PAYMENT.account}>
              <span class="c1">{t.common.copy}</span><span class="c2">{t.common.copied}</span>
            </button>
          </dd>
        </div>
        <div>
          <dt>{t.order.holder}</dt>
          <dd>{PAYMENT.holder}</dd>
        </div>
      </dl>
      <span class="mark-bg" aria-hidden="true">PANDO</span>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/order';
</script>

<style>
  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .steps b {
    color: var(--text);
    font-weight: 500;
    font-size: 1rem;
  }
  .sn {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .builder {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .builder {
      grid-template-columns: 1.4fr 1fr;
    }
    .summary {
      position: sticky;
      top: calc(var(--header-h) + 1rem);
    }
  }
  .group {
    margin: 0 0 2rem;
    padding: 0;
    border: 0;
  }
  .group legend {
    margin-bottom: 0.9rem;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.8rem 0.6rem 0.6rem;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      box-shadow 0.3s ease,
      transform 0.4s var(--ease-out);
  }
  .item:global(.has-qty) {
    box-shadow:
      inset 0 0 0 2px var(--accent),
      var(--shadow);
  }
  .thumb {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface-2);
    color: var(--mat-coffee-2);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .finish-titan {
    background: color-mix(in srgb, var(--titan) 22%, var(--surface-2));
    color: var(--titan);
  }
  .finish-warm {
    background: var(--gold-soft);
    color: var(--gold);
  }
  .finish-titan img {
    filter: grayscale(0.85) contrast(1.05);
  }
  .meta {
    display: grid;
    gap: 0.2rem;
  }
  .name {
    font-weight: 500;
    line-height: 1.35;
  }
  .name a {
    text-decoration: none;
  }
  .name a:hover {
    color: var(--accent);
  }
  .price {
    color: var(--gold);
    font-weight: 600;
  }
  .price small {
    color: var(--muted);
    font-weight: 400;
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--hover);
  }
  .stepper button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.2rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.3s var(--ease-spring);
  }
  .stepper button:hover {
    background: var(--surface);
  }
  .stepper button:active {
    transform: scale(0.88);
  }
  .stepper input {
    width: 2.6rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .stepper input::-webkit-inner-spin-button,
  .stepper input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }
  @media (max-width: 520px) {
    .item {
      grid-template-columns: auto 1fr;
    }
    .stepper {
      grid-column: 1 / -1;
      justify-self: end;
    }
  }

  .summary {
    margin: 0;
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .summary h2 {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .lines {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    max-height: 16rem;
    overflow: auto;
  }
  .lines :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.92rem;
    animation: rise 0.45s var(--ease-out) both;
  }
  .lines :global(.empty) {
    color: var(--muted);
  }
  .lines :global(b) {
    font-weight: 600;
    white-space: nowrap;
  }
  .totals div {
    display: flex;
    justify-content: space-between;
    padding-block: 0.8rem;
    border-top: 1px solid var(--line);
  }
  .totals dt {
    color: var(--muted);
  }
  .totals dd {
    margin: 0;
    font-weight: 600;
  }
  .area {
    margin: 0.4rem 0 1rem;
    padding: 0.8rem 0 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  .area legend {
    float: left;
    width: 100%;
    margin-bottom: 0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .area label {
    clear: both;
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    padding: 0.7rem 0.8rem;
    margin-bottom: 0.4rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .area label:has(input:checked) {
    background: var(--glass-night);
    box-shadow: inset 0 0 0 1px var(--line-night);
  }
  .area input {
    accent-color: var(--gold);
    margin-top: 0.3rem;
  }
  .area span {
    display: grid;
  }
  .area small {
    color: var(--muted);
  }
  .ship-note {
    margin: 0.3rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .grand {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 0 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .grand b {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--gold-light);
    font-variant-numeric: tabular-nums;
  }
  .grand b:global(.bump) {
    animation: bump 0.45s var(--ease-spring);
  }
  @keyframes bump {
    40% {
      transform: scale(1.08);
    }
  }
  .actions {
    display: grid;
    gap: 0.6rem;
  }
  .actions :global(.is-done) {
    --btn-bg: var(--leaf);
  }

  .pay {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .pay {
      grid-template-columns: 1fr 1fr;
    }
  }
  .bank-card {
    position: relative;
    max-width: 30rem;
    aspect-ratio: 1.586;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-radius: 22px;
    overflow: hidden;
    color: var(--on-night);
    background:
      radial-gradient(80% 90% at 100% 0%, var(--leaf-glow), transparent 60%),
      radial-gradient(70% 80% at 0% 100%, var(--gold-haze), transparent 70%),
      linear-gradient(135deg, var(--night-2), var(--night));
    box-shadow: var(--shadow-float);
    display: grid;
    align-content: space-between;
  }
  .chip-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .chip-gold {
    width: 46px;
    height: 34px;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
  }
  .bank {
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .bank-card dl {
    position: relative;
    z-index: 1;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }
  .bank-card dt {
    font-size: 0.78rem;
    color: var(--on-night-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .bank-card dd {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 500;
  }
  .acc {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
  }
  .acc > span {
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
  .copy {
    position: relative;
    flex: none;
    white-space: nowrap;
    min-height: 34px;
    padding: 0.3rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--glass-night);
    color: var(--on-night);
    box-shadow: inset 0 0 0 1px var(--line-night);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .copy .c2 {
    display: none;
  }
  .copy:global(.is-copied) .c1 {
    display: none;
  }
  .copy:global(.is-copied) .c2 {
    display: inline;
    color: var(--leaf);
  }
  .mark-bg {
    position: absolute;
    right: -0.5rem;
    bottom: -1.6rem;
    font-size: 6rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: rgb(255 255 255 / 0.04);
    pointer-events: none;
  }
</style>
