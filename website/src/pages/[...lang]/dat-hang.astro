---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Headline from '../../components/Headline.astro';
import { SHOP, type ShopItem } from '../../data/shop';
import { COMPANY, PAYMENT, SHIPPING } from '../../data/site';
import { format, localePath, localeStaticPaths, money, tx, useTranslations, type Locale } from '../../i18n';
import { photo } from '../../lib/photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const groups = (['candle', 'coaster', 'keychain'] as const).map((key) => ({
  key,
  name: t.order.groups[key],
  items: SHOP.filter((item) => item.group === key),
}));
const config = {
  locale,
  items: SHOP.map((item: ShopItem) => ({ id: item.id, name: tx(locale, item.name), price: item.price, unit: tx(locale, item.unit) })),
  shipping: SHIPPING,
  zalo: COMPANY.zalo,
  text: {
    intro: t.order.orderText,
    total: t.order.orderTotal,
    empty: t.order.empty,
    copied: t.common.copied,
    copy: t.order.copyOrder,
    count: t.order.itemCount,
    remove: t.order.removeItem,
    cleared: t.order.cleared,
    undo: t.order.undo,
  },
};
// Read the account the way it is printed on bank slips: 0935 832 459.
const accountGroups = PAYMENT.account.replace(/^(\d{4})(\d{3})(\d+)$/, '$1 $2 $3');
const COPY_ICON = 'M7.5 7h8A1.5 1.5 0 0 1 17 8.5v8a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 6 16.5v-8A1.5 1.5 0 0 1 7.5 7ZM13 4.5A1.5 1.5 0 0 0 11.5 3h-7A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13';
const DONE_ICON = 'M4 10.5 8 14.5 16 6';
const ICONS: Record<ShopItem['group'], string> = {
  candle: 'M12 3c1.6 1.8 2.2 3.1 1.6 4.3-.4.9-1.2 1.3-1.6 1.3s-1.2-.4-1.6-1.3C9.8 6.1 10.4 4.8 12 3ZM12 10v2M6 13h12l-1.2 7.2a1 1 0 0 1-1 .8H8.2a1 1 0 0 1-1-.8L6 13Z',
  coaster: 'M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18Zm0 3a6 6 0 1 0 0 12 6 6 0 0 0 0-12Z',
  keychain: 'M8 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm2.8 6.8 5.4 5.4M14 13l2-2M16.5 15.5l2-2M15.5 21c-2-1-3-3-3-5 2 0 4 1 5 3',
};
---

<Base
  locale={locale}
  page="order"
  title={t.meta.order.title}
  description={t.meta.order.description}
  image="coaster-coffee-tray"
  breadcrumbs={[{ name: t.nav.order, path: localePath(locale, 'order') }]}
  showClosing={false}
>
  <PageHeader locale={locale} tag={t.order.tag} title={t.order.title} lead={t.order.lead} crumbs={[{ name: t.nav.order, path: '' }]}>
    <ol class="steps rise" style="--d:0.7s">
      {
        t.order.steps.map((step, index) => (
          <li>
            <span class="sn">{index + 1}</span>
            <b>{step.title}</b>
            <span>{step.text}</span>
          </li>
        ))
      }
    </ol>
  </PageHeader>

  <section class="container builder" data-order={JSON.stringify(config)}>
    <div class="list">
      <h2 class="visually-hidden">{t.order.pick}</h2>
      {
        groups.map((group) => (
          <fieldset class="group" data-reveal>
            <legend>{group.name}</legend>
            <ul>
              {group.items.map((item) => (
                <li class="item spot" data-item={item.id}>
                  <span class:list={['thumb', `finish-${item.finish}`]}>
                    {item.photo ? (
                      <Image src={photo(item.photo)} alt="" widths={[120, 200]} sizes="88px" />
                    ) : (
                      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
                        <path d={ICONS[item.group]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <span class="meta">
                    <span class="name">
                      {item.product ? <a href={localePath(locale, `san-pham/${item.product}`)}>{tx(locale, item.name)}</a> : tx(locale, item.name)}
                    </span>
                    <span class="price">
                      {money(locale, item.price)}
                      <small>{format(t.order.each, { unit: tx(locale, item.unit) })}</small>
                    </span>
                  </span>
                  <span class="stepper">
                    <button type="button" data-step="-1" aria-label={`${t.order.decrease}: ${tx(locale, item.name)}`}>
                      −
                    </button>
                    <input type="number" min="0" max="999" value="0" inputmode="numeric" aria-label={`${t.order.qty}: ${tx(locale, item.name)}`} />
                    <button type="button" data-step="1" aria-label={`${t.order.increase}: ${tx(locale, item.name)}`}>
                      +
                    </button>
                  </span>
                </li>
              ))}
            </ul>
          </fieldset>
        ))
      }
    </div>

    <aside class="summary" aria-labelledby="summary-title" data-summary>
      <div class="receipt-wrap">
        <div class="receipt">
          <div class="receipt-head">
            <h2 id="summary-title">{t.order.summary}</h2>
            <span class="count" data-count hidden></span>
            <button type="button" class="clear" data-clear hidden>{t.order.clearAll}</button>
          </div>
          <ul class="lines" data-lines aria-live="polite">
            <li class="empty">{t.order.empty}</li>
          </ul>
          <fieldset class="area">
            <legend>{t.order.area}</legend>
            <label>
              <input type="radio" name="area" value="inner" checked />
              <span>
                <b>{t.order.inner}</b>
                <small>{money(locale, SHIPPING.inner.min)} - {money(locale, SHIPPING.inner.max)}</small>
                <small>{format(t.order.eta, { days: SHIPPING.innerDays })}</small>
              </span>
            </label>
            <label>
              <input type="radio" name="area" value="outer" />
              <span>
                <b>{t.order.outer}</b>
                <small>{money(locale, SHIPPING.outer.min)} - {money(locale, SHIPPING.outer.max)}</small>
                <small>{format(t.order.eta, { days: SHIPPING.outerDays })}</small>
              </span>
            </label>
            <p class="ship-note">{t.order.shippingNote}</p>
          </fieldset>
          <p class="grand">
            <span>{t.order.total}</span>
            <b data-total>{money(locale, 0)}</b>
          </p>
        </div>
      </div>
      <div class="actions">
        <a class="btn btn-zalo" href={COMPANY.zalo} rel="noopener" target="_blank" data-send-zalo>{t.order.sendZalo}</a>
        <button type="button" class="btn btn-ghost btn-sm" data-copy-order>{t.order.copyOrder}</button>
        <a class="btn btn-ghost btn-sm" href={COMPANY.orderForm} rel="noopener" target="_blank">{t.order.openForm}</a>
      </div>
    </aside>
  </section>

  <section class="section container pay zone" data-tone="cream">
    <div class="pay-copy">
      <p class="tag" data-reveal>{t.order.payTag}</p>
      <Headline text={t.order.payTitle} />
      <p class="muted" data-reveal>{t.order.payNote}</p>
      <a class="btn btn-zalo" href={COMPANY.zalo} rel="noopener" target="_blank" data-reveal>{t.order.sendProof}</a>
    </div>
    <dl class="bank" data-reveal-group>
      <div class="tile t-acc">
        <dt>{t.order.account}</dt>
        <dd>
          <span class="acc-num" aria-label={PAYMENT.account}>{accountGroups}</span>
          <button type="button" class="copy" data-copy={PAYMENT.account}>
            <svg class="i-copy" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d={COPY_ICON} /></svg>
            <svg class="i-done" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d={DONE_ICON} /></svg>
            <span class="c1">{t.common.copy}</span><span class="c2">{t.common.copied}</span>
          </button>
        </dd>
      </div>
      <div class="tile t-bank">
        <dt>{t.order.bank}</dt>
        <dd><span class="bank-mark" aria-hidden="true">MB</span>{PAYMENT.bank}</dd>
      </div>
      <div class="tile t-holder">
        <dt>{t.order.holder}</dt>
        <dd>
          <span class="holder">{PAYMENT.holder}</span>
          <button type="button" class="copy copy-icon" data-copy={PAYMENT.holder} aria-label={`${t.common.copy}: ${t.order.holder}`} title={t.common.copy}>
            <svg class="i-copy" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d={COPY_ICON} /></svg>
            <svg class="i-done" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d={DONE_ICON} /></svg>
          </button>
        </dd>
      </div>
    </dl>
  </section>
</Base>

<script>
  import '../../scripts/order';
</script>

<style>
  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .steps b {
    color: var(--text);
    font-weight: 500;
    font-size: 1rem;
  }
  .sn {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .builder {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .builder {
      grid-template-columns: 1.4fr 1fr;
    }
    /* Pinned beside the list; a receipt taller than the screen scrolls along until its end is in view (--summary-h, order.ts). */
    .summary {
      position: sticky;
      top: min(calc(var(--header-h) + 1rem), calc(100dvh - var(--summary-h, 0px) - 1rem));
    }
  }
  .group {
    margin: 0 0 2rem;
    padding: 0;
    border: 0;
  }
  .group legend {
    margin-bottom: 0.9rem;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.8rem 0.6rem 0.6rem;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      box-shadow 0.3s ease,
      transform 0.4s var(--ease-out);
  }
  .item:global(.has-qty) {
    box-shadow:
      inset 0 0 0 2px var(--accent),
      var(--shadow);
  }
  .thumb {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface-2);
    color: var(--mat-coffee-2);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .finish-titan {
    background: color-mix(in srgb, var(--titan) 22%, var(--surface-2));
    color: var(--titan);
  }
  .finish-warm {
    background: var(--gold-soft);
    color: var(--gold);
  }
  .finish-titan img {
    filter: grayscale(0.85) contrast(1.05);
  }
  .meta {
    display: grid;
    gap: 0.2rem;
  }
  .name {
    font-weight: 500;
    line-height: 1.35;
  }
  .name a {
    text-decoration: none;
  }
  .name a:hover {
    color: var(--accent);
  }
  .price {
    color: var(--gold);
    font-weight: 600;
  }
  .price small {
    color: var(--muted);
    font-weight: 400;
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--hover);
  }
  .stepper button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.2rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.3s var(--ease-spring);
  }
  .stepper button:hover {
    background: var(--surface);
  }
  .stepper button:active {
    transform: scale(0.88);
  }
  .stepper input {
    width: 2.6rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .stepper input::-webkit-inner-spin-button,
  .stepper input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }
  @media (max-width: 520px) {
    .item {
      grid-template-columns: auto 1fr;
    }
    .stepper {
      grid-column: 1 / -1;
      justify-self: end;
    }
  }

  /* The receipt: an espresso header, the lines on paper with dotted leaders, a torn bottom edge. */
  .summary {
    display: grid;
    gap: 1.1rem;
  }
  .receipt-wrap {
    filter: drop-shadow(0 24px 30px var(--shadow-ink)) drop-shadow(0 1px 2px var(--shadow-ink));
  }
  .receipt {
    --pad: clamp(1.2rem, 2.6vw, 1.6rem);
    --tooth: 9px;
    position: relative;
    padding-bottom: calc(var(--tooth) + var(--pad));
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--receipt);
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / calc(var(--tooth) * 2) 100%;
  }
  .receipt-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem var(--pad);
    border-radius: var(--radius) var(--radius) 0 0;
    color: var(--on-night);
    background:
      radial-gradient(70% 160% at 100% 0%, color-mix(in srgb, var(--caramel-2) 42%, transparent), transparent 70%),
      radial-gradient(50% 140% at 0% 100%, color-mix(in srgb, var(--mat-beet-2) 30%, transparent), transparent 70%),
      linear-gradient(120deg, var(--night), var(--mat-coffee));
  }
  .summary h2 {
    margin: 0;
    font-size: clamp(1.2rem, 4.4vw, 1.45rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .count,
  .clear {
    white-space: nowrap;
  }
  .count {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--caramel-1);
    color: var(--caramel-ink);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .clear {
    margin-inline-start: auto;
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: var(--glass-night);
    color: var(--on-night);
    box-shadow: inset 0 0 0 1px var(--line-night);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .clear:hover {
    background: var(--mat-beet);
    color: var(--ink-black);
  }
  .count[hidden],
  .clear[hidden] {
    display: none;
  }
  /* Every chosen line is listed: the receipt grows with the order. */
  .lines {
    list-style: none;
    margin: 0;
    padding: 0.4rem var(--pad) 0;
  }
  .lines :global(.line) {
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(1rem, 1fr) auto auto;
    align-items: start;
    column-gap: 0.55rem;
    padding: 0.75rem 0;
    border-bottom: 1px dashed var(--line-strong);
    font-size: 0.95rem;
    animation: rise 0.45s var(--ease-out) both;
  }
  .lines :global(.line-name) {
    display: grid;
    gap: 0.15rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .lines :global(.line-name small) {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .lines :global(.leader) {
    margin-top: 0.95em;
    border-bottom: 2px dotted var(--line-strong);
  }
  .lines :global(.line b) {
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .lines :global(.line-remove) {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -0.15rem -0.3rem 0 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .lines :global(.line-remove:hover),
  .lines :global(.line-remove:focus-visible) {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 10%, transparent);
  }
  .lines :global(.empty) {
    padding: 1.4rem 0.4rem 1.2rem;
    border-bottom: 1px dashed var(--line-strong);
    color: var(--muted);
    font-size: 0.92rem;
    text-align: center;
  }
  .lines :global(.undo) {
    margin-inline-start: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--gold);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  /* Two delivery areas side by side; the legend floats so it sits inside the grid. */
  .area {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 1.1rem var(--pad) 0;
    padding: 0;
    border: 0;
  }
  @media (max-width: 480px) {
    .area {
      grid-template-columns: 1fr;
    }
  }
  .area legend {
    float: left;
    grid-column: 1 / -1;
    margin-bottom: 0.1rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .area label {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    padding: 0.65rem 0.7rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: 0.93rem;
    line-height: 1.35;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .area label:hover {
    background: var(--hover);
  }
  .area label:has(input:checked) {
    background: var(--gold-soft);
    box-shadow: inset 0 0 0 1.5px var(--gold);
  }
  .area input {
    flex: none;
    accent-color: var(--caramel-3);
    margin: 0.2rem 0 0;
  }
  .area span {
    display: grid;
    gap: 0.1rem;
  }
  .area b {
    font-weight: 600;
  }
  .area small {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .ship-note {
    grid-column: 1 / -1;
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .grand {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 1.2rem var(--pad) 0;
    padding-top: 1rem;
    border-top: 3px double var(--line-strong);
  }
  .grand span {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .grand b {
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .grand b:global(.bump) {
    animation: bump 0.45s var(--ease-spring);
  }
  @keyframes bump {
    40% {
      transform: scale(1.08);
    }
  }
  /* Zalo first and full width; the two other ways sit side by side when they fit on one line each. */
  .actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr));
    gap: 0.6rem;
  }
  .actions .btn {
    white-space: nowrap;
  }
  .actions .btn-zalo {
    grid-column: 1 / -1;
  }
  .btn-zalo {
    --btn-bg: var(--zalo);
    --btn-fg: var(--white);
    font-weight: 600;
  }
  .btn-zalo:hover {
    --btn-bg: var(--zalo-deep);
  }
  .actions :global(.is-done) {
    --btn-bg: var(--gold-soft);
    --btn-fg: var(--text);
  }

  /* Payment: the details as tiles in different colours, the account number the largest. */
  .pay {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .pay {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .pay-copy .btn {
    margin-top: 0.6rem;
  }
  .bank {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
  }
  @media (max-width: 520px) {
    .bank {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: space-between;
    gap: 1.4rem;
    min-height: 8.5rem;
    padding: clamp(1.1rem, 2.6vw, 1.5rem);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .tile dt {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
