---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Headline from '../../components/Headline.astro';
import Social from '../../components/Social.astro';
import { COMPANY } from '../../data/site';
import { localePath, localeStaticPaths, tx, useTranslations, type Locale } from '../../i18n';
import { photo } from '../../lib/photos';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const cards = [
  { label: t.contact.hotline, value: COMPANY.phone, href: COMPANY.phoneHref, icon: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z' },
  { label: 'Zalo', value: 'Pando Ecotech', href: COMPANY.zalo, icon: 'M12 3C6.5 3 2 6.8 2 11.4c0 2.6 1.4 4.9 3.7 6.4L5 21l3.6-1.9c1.1.3 2.2.5 3.4.5 5.5 0 10-3.8 10-8.3S17.5 3 12 3Z' },
  { label: t.contact.email, value: COMPANY.email, href: `mailto:${COMPANY.email}`, icon: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.2V17h16V7.2l-8 5.6-8-5.6Z' },
];
---

<Base
  locale={locale}
  page="contact"
  title={t.meta.contact.title}
  description={t.meta.contact.description}
  image="expo-group"
  breadcrumbs={[{ name: t.nav.contact, path: localePath(locale, 'contact') }]}
>
  <PageHeader locale={locale} tag={t.contact.tag} title={t.contact.title} lead={t.contact.lead} crumbs={[{ name: t.nav.contact, path: '' }]} />

  <section class="container reach">
    <ul class="cards" data-reveal-group>
      {
        cards.map((card) => (
          <li>
            <a class="card-c spot" href={card.href} rel="noopener" target={card.href.startsWith('http') ? '_blank' : undefined}>
              <span class="ic">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path d={card.icon} fill="currentColor" />
                </svg>
              </span>
              <span class="label">{card.label}</span>
              <span class="value">{card.value}</span>
              <span class="arrow" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container office">
    <div class="map panel" data-reveal="mask">
      <iframe
        src={COMPANY.mapEmbed}
        title={t.contact.mapTitle}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
    <div class="details">
      <p class="tag" data-reveal>{t.contact.office}</p>
      <h2 class="org" data-reveal>{locale === 'vi' ? COMPANY.legalName : COMPANY.legalNameEn}</h2>
      <address data-reveal>{tx(locale, COMPANY.address)}</address>
      <dl data-reveal>
        <div>
          <dt>{t.contact.taxId}</dt>
          <dd>{COMPANY.taxId}</dd>
        </div>
        <div>
          <dt>{t.contact.social}</dt>
          <dd><Social /></dd>
        </div>
      </dl>
      <a class="btn btn-accent" href={COMPANY.mapLink} rel="noopener" target="_blank" data-reveal
        >{t.contact.directions} <span class="arrow" aria-hidden="true"></span></a
      >
    </div>
  </section>

  <section class="partner panel on-night">
    <div class="container section partner-inner">
      <div>
        <p class="tag" data-reveal>{t.contact.partnerTag}</p>
        <Headline text={t.contact.partnerTitle} />
        <p class="muted" data-reveal>{t.contact.partnerText}</p>
        <ul class="check-list" data-reveal-group>
          {t.contact.partnerList.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="stack" data-reveal-group>
        <div class="photo"><Image src={photo('cafe-friends-2')} alt="" widths={[360, 600]} sizes="(min-width: 900px) 24vw, 46vw" /></div>
        <div class="photo"><Image src={photo('caphin-team-2')} alt="" widths={[360, 600]} sizes="(min-width: 900px) 24vw, 46vw" /></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 800px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card-c {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: 1.6rem;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }
  .card-c:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-float);
  }
  .ic {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 0.8rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .label {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .value {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .card-c .arrow {
    position: absolute;
    top: 1.6rem;
    right: 1.6rem;
    margin: 0;
    transition: transform 0.4s var(--ease-out);
  }
  .card-c:hover .arrow {
    transform: rotate(-45deg);
  }
  .office {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .office {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .map {
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
    box-shadow: var(--shadow-float);
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  :global(:root[data-theme='dark']) .map iframe {
    filter: invert(0.9) hue-rotate(180deg) saturate(0.6);
  }
  .org {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }
  address {
    font-style: normal;
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .details dl {
    margin: 0 0 1.6rem;
  }
  .details dl div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: center;
    padding-block: 0.8rem;
    border-top: 1px solid var(--line);
  }
  .details dt {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .details dd {
    margin: 0;
  }
  .partner-inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .partner-inner {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .partner-inner :global(h2) {
    margin-bottom: 1.2rem;
  }
  .partner .check-list {
    margin-top: 1.5rem;
  }
  .stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .stack .photo {
    aspect-ratio: 3 / 4;
  }
  .stack .photo:nth-child(2) {
    margin-top: 3rem;
  }
</style>
